# DigitalOcean API Token (required)
# Get your token from: https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_API_TOKEN=your_token_here

# Spaces Access Keys (optional, for object storage)
# Generate from: https://cloud.digitalocean.com/account/api/spaces
SPACES_ACCESS_KEY=your_spaces_access_key
SPACES_SECRET_KEY=your_spaces_secret_key

# Default Region (optional)
DO_DEFAULT_REGION=nyc3
